# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Generated scripts, stems, TTS cache, vocals
work/

# SoundCraft sessions copy third-party samples into Audio Files — do not redistribute
# Renders (WAV/MP3) live in Cloudflare R2: node tools/assets.mjs push out/<name>.wav out/<name>.mp3
out/

# Reference tracks and what is derived from them (stems, MIDI) are someone else's recordings: R2 only.
# Profiles (refs/*.profile.json) are abstract statistics and are committed.
refs/*/
refs/*.wav
refs/*.mp3
refs/*.flac
# Embedding caches from tools/embed.py (R2: node tools/assets.mjs push refs/<name>.clap.npz)
refs/*.npz

# Sample libraries are nested clones (download separately; see samples/README.md).
# Do not add them as gitlinks.
samples/salamander/
samples/vsco2/
samples/vcsl/
samples/iowa/
samples/philharmonia/

# OS / editor
Thumbs.db
.DS_Store
*.swp

# Video project dependencies (video/package.json)
video/node_modules/
